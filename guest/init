#!/bin/bash
# The run's init, started by /usr/lib/qim/boot as PID 1 with /proc, /sys,
# /dev and /run mounted and the input disk unpacked into /run/qim/in.
#
# Disks: vda base image (read-only root), vdb empty ext4 for the overlay's
# upper layer, vdc input tar, vdd output (a tar is written to it raw), vde
# audit records (written raw by the audit reader).
set -u
in=/run/qim/in
# shellcheck source=/dev/null
source "$in/config"
mapfile -d '' -t argv <"$in/argv"

# fd 2 is the console the kernel gave to PID 1; /dev/console is not in the new root.
log() { echo "qim-init: $*" >&2; }
die() {
  log "$*"
  poweroff -f
}

# Opened before the root changes: the output disk and, below, the upper layer.
exec 9>/dev/vdd || die "cannot open the output disk"

# The reader starts from the original root, so nothing in the overlay root
# that the command sees refers to it or to the audit disk. It runs under its
# own uid with only the capabilities it needs, so that a command that becomes
# root (but loses CAP_KILL and CAP_SYS_PTRACE, below) cannot signal or trace
# it. It opens the disk itself, with O_DIRECT, so the disk's node (root's,
# mode 0600, in this root's devtmpfs only) is handed to its uid instead of
# giving it CAP_DAC_OVERRIDE.
chown 999:999 /dev/vde || die "cannot hand the audit disk to the reader"
reader_caps=+audit_control,+audit_read,+net_admin
setpriv --reuid=999 --regid=999 --clear-groups --inh-caps="-all,$reader_caps" --ambient-caps="$reader_caps" \
  "$in/audit-reader" /dev/vde 9>&- 2>/dev/console &
reader=$!
for _ in $(seq 50); do
  [ "$(auditctl -s | awk '$1 == "pid" {print $2}')" = "$reader" ] && break
  sleep 0.1
done
[ "$(auditctl -s | awk '$1 == "pid" {print $2}')" = "$reader" ] || die "the audit reader did not register"
modprobe overlay || die "cannot load overlay"
modprobe virtio_net || die "cannot load virtio_net"
# Nothing may load code into the kernel from now on, and io_uring operations
# would bypass the syscall audit rules.
sysctl -q -w kernel.modules_disabled=1 kernel.io_uring_disabled=2 || die "cannot restrict the kernel"

mkdir -p /run/qim/upper-disk /run/qim/root
mount -t ext4 /dev/vdb /run/qim/upper-disk || die "cannot mount the upper disk"
mkdir -p /run/qim/upper-disk/upper /run/qim/upper-disk/work
mount -t overlay overlay \
  -o lowerdir=/,upperdir=/run/qim/upper-disk/upper,workdir=/run/qim/upper-disk/work,metacopy=off,redirect_dir=off,index=off \
  /run/qim/root || die "cannot mount the overlay"
exec 8</run/qim/upper-disk/upper

root=/run/qim/root
mount -t proc proc "$root/proc"
# Without CAP_SYS_ADMIN the command cannot remount these, so kernel settings
# such as kernel.io_uring_disabled stay as set above even for root.
mount --bind "$root/proc/sys" "$root/proc/sys"
mount -o remount,bind,ro "$root/proc/sys"
mount -t sysfs -o ro sys "$root/sys"
# A minimal /dev without the disks.
mount -t tmpfs -o mode=0755,nosuid dev "$root/dev"
for node in null:1:3 zero:1:5 full:1:7 random:1:8 urandom:1:9 tty:5:0; do
  IFS=: read -r name major minor <<<"$node"
  mknod -m 666 "$root/dev/$name" c "$major" "$minor"
done
ln -s pts/ptmx "$root/dev/ptmx"
mkdir -p "$root/dev/pts" "$root/dev/shm"
mount -t devpts -o gid=5,mode=620,ptmxmode=666 devpts "$root/dev/pts"
mount -t tmpfs -o mode=1777,nosuid,nodev shm "$root/dev/shm"
mount -t tmpfs -o mode=0755,nosuid,nodev run "$root/run"
mount -t tmpfs -o mode=1777,nosuid,nodev tmp "$root/tmp"
for link in fd:/proc/self/fd stdin:/proc/self/fd/0 stdout:/proc/self/fd/1 stderr:/proc/self/fd/2; do
  ln -sfn "${link#*:}" "$root/dev/${link%%:*}"
done

# pivot_root(".", ".") stacks the old root on the new one; detaching it leaves
# only the overlay, without creating a directory for the old root in it.
cd "$root" && pivot_root . . && umount -l . || die "cannot switch to the overlay root"
cd /

ip link set lo up
ip addr add "$QIM_ADDRESS" dev eth0
ip link set eth0 up
ip route add default via "$QIM_GATEWAY"

# The rules record only processes whose loginuid (auid) is this marker: the
# command and its descendants (see where the command starts). The init's own
# steps, the sampler and the reader keep the unset loginuid and are not recorded.
audit_marker=4242
auditctl -D >/dev/null
for rule in \
  "-S execve,execveat -k exec" \
  "-S open,openat,openat2,creat -k open" \
  "-S unlink,unlinkat,rename,renameat,renameat2,mkdir,mkdirat,rmdir,link,linkat,symlink,symlinkat -k fsmod" \
  "-S chdir,fchdir,dup,dup2,dup3,close,close_range,fcntl -k fd" \
  "-S clone,clone3,fork,vfork -k proc" \
  "-S connect,sendto,sendmsg,sendmmsg -k net"; do
  # shellcheck disable=SC2086
  auditctl -a always,exit -F arch=b64 -F auid="$audit_marker" $rule >/dev/null || die "cannot add audit rule: $rule"
done
auditctl -e 2 >/dev/null || die "cannot lock the audit configuration"

# Capabilities the command never gets, even as root through sudo: creating
# device nodes, mounting, loading modules, raw I/O, tracing or signalling
# other users' processes (the audit reader), changing audit or the network.
drop=-mknod,-sys_admin,-sys_module,-sys_rawio,-sys_ptrace,-sys_boot,-audit_control,-audit_read,-kill,-net_admin,-net_raw,-mac_admin,-mac_override,-bpf,-perfmon,-syslog,-sys_time

mkdir -p /run/qim/meta
if [ -n "$QIM_USER" ]; then
  home=$(getent passwd "$QIM_USER" | cut -d: -f6)
  runner=(setpriv --reuid="$QIM_USER" --regid="$QIM_USER" --init-groups --reset-env --bounding-set="$drop")
else
  home=/root
  runner=(setpriv --bounding-set="$drop" env -i HOME=/root USER=root LOGNAME=root PATH=/usr/local/sbin:/usr/local/bin:/usr/bin)
fi
cd "$home" || die "no home directory $home"

# Diagnostics, one line every 5 seconds while the command runs: seconds since
# it started, the kernel's audit backlog and lost counters, and MemAvailable.
sample() {
  local pause=
  # Stop at once, without leaving the sleep behind.
  trap '[ -z "$pause" ] || kill "$pause"; exit 0' TERM
  SECONDS=0
  while :; do
    { auditctl -s; cat /proc/meminfo; } | awk -v t="$SECONDS" '
      $1 == "backlog" { backlog = $2 }
      $1 == "lost" { lost = $2 }
      $1 == "MemAvailable:" { available = $2 }
      END { printf "t=%s backlog=%s lost=%s mem_available_kb=%s\n", t, backlog, lost, available }'
    sleep 5 &
    pause=$!
    wait "$pause"
    pause=
  done
}
sample >/run/qim/meta/samples 2>&1 &
sampler=$!

log "running: ${argv[*]}"
# The command's first process takes the audit marker as its loginuid. Setting
# an unset loginuid needs no privilege, but changing a set one needs
# CAP_AUDIT_CONTROL, which the command's bounding set drops, so the command and
# every descendant (fork and exec inherit it, sudo keeps it) stay marked.
(
  echo "$audit_marker" >/proc/self/loginuid || die "cannot mark the command for audit" 2>/proc/1/fd/2
  exec timeout --kill-after=10 "$QIM_TIMEOUT" "${runner[@]}" env LANG=C.UTF-8 TERM=dumb "${argv[@]}"
) </dev/null >/run/qim/meta/command.log 2>&1
echo "$?" >/run/qim/meta/exit_code
kill "$sampler" 2>/dev/null
wait "$sampler"
cd /

# Stop everything the command left behind so that the upper layer is quiet,
# except the audit reader.
for _ in 1 2 3; do
  for entry in /proc/[0-9]*; do
    pid=${entry#/proc/}
    [ "$pid" = 1 ] || [ "$pid" = "$reader" ] || kill -9 "$pid" 2>/dev/null
  done
  sleep 0.5
done
sync

# Let the reader drain the kernel queue before it stops.
for _ in $(seq 6000); do
  [ "$(auditctl -s | awk '$1 == "backlog" {print $2}')" = 0 ] && break
  sleep 0.1
done
auditctl -s >/run/qim/meta/audit_status
kill -TERM "$reader"
wait "$reader"
echo "$?" >/run/qim/meta/audit_reader_exit
# /dev/kmsg is not in this root; dmesg falls back to syslog(2).
dmesg >/run/qim/meta/dmesg 2>&1
# The S flag keeps symlink targets as they are; names and hard link targets move under upper/.
tar --create --file=- --numeric-owner --xattrs \
  --xattrs-include='trusted.overlay.*' --xattrs-include='security.capability' \
  -C /run/qim meta -C /proc/self/fd/8 --transform='s,^\.,upper,S' . >&9 || log "cannot write the output"
exec 9>&-
sync
poweroff -f
