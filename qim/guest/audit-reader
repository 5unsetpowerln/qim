#!/usr/bin/env python3
"""Receive audit records from the kernel and write them to an inherited fd.

Usage: audit-reader <fd>

Registers itself as the audit daemon, configures the kernel queue so that it
never drops records for backlog or rate reasons, and writes every record as a
line in the format auditd uses for log_format = RAW:

    type=<NAME> msg=<payload>

EOE records are not written, matching auditd's RAW logs. SIGTERM makes the
reader drain what the socket already holds, flush and exit. The exit status
is 0, or 2 if the socket ever overflowed (ENOBUFS), in which case records may
be missing even though the kernel's lost counter does not say so.
"""
import errno
import os
import signal
import socket
import struct
import sys

NETLINK_AUDIT = 9
SO_RCVBUFFORCE = 33
NLMSG_ERROR = 2
NLM_F_REQUEST = 0x1
NLM_F_ACK = 0x4
AUDIT_SET = 1001
AUDIT_EOE = 1320
STATUS_ENABLED, STATUS_FAILURE, STATUS_PID, STATUS_RATE_LIMIT, STATUS_BACKLOG_LIMIT = 0x1, 0x2, 0x4, 0x8, 0x10
FAILURE_PRINTK = 1

NAMES = {
    1100: "USER_AUTH", 1101: "USER_ACCT", 1102: "USER_MGMT", 1103: "CRED_ACQ", 1104: "CRED_DISP",
    1105: "USER_START", 1106: "USER_END", 1107: "USER_AVC", 1108: "USER_CHAUTHTOK", 1109: "USER_ERR",
    1110: "CRED_REFR", 1111: "USYS_CONFIG", 1112: "USER_LOGIN", 1113: "USER_LOGOUT",
    1114: "ADD_USER", 1115: "DEL_USER", 1116: "ADD_GROUP", 1117: "DEL_GROUP",
    1124: "USER_CMD", 1125: "USER_TTY", 1130: "SERVICE_START", 1131: "SERVICE_STOP",
    1200: "DAEMON_START", 1201: "DAEMON_END", 1202: "DAEMON_ABORT", 1203: "DAEMON_CONFIG",
    1300: "SYSCALL", 1302: "PATH", 1303: "IPC", 1304: "SOCKETCALL", 1305: "CONFIG_CHANGE",
    1306: "SOCKADDR", 1307: "CWD", 1309: "EXECVE", 1311: "IPC_SET_PERM", 1316: "KERNEL_OTHER",
    1317: "FD_PAIR", 1318: "OBJ_PID", 1319: "TTY", 1321: "BPRM_FCAPS", 1322: "CAPSET", 1323: "MMAP",
    1324: "NETFILTER_PKT", 1325: "NETFILTER_CFG", 1326: "SECCOMP", 1327: "PROCTITLE",
    1328: "FEATURE_CHANGE", 1329: "REPLACE", 1330: "KERN_MODULE", 1331: "FANOTIFY", 1334: "BPF",
    1336: "URINGOP", 1337: "OPENAT2", 2000: "KERNEL",
}

stopping = False


def on_term(_signum, _frame):
    global stopping
    stopping = True


def status_message(pid: int) -> bytes:
    mask = STATUS_ENABLED | STATUS_FAILURE | STATUS_PID | STATUS_RATE_LIMIT | STATUS_BACKLOG_LIMIT
    # struct audit_status: mask, enabled, failure, pid, rate_limit, backlog_limit (then fields we leave 0)
    payload = struct.pack("=11I", mask, 1, FAILURE_PRINTK, pid, 0, 0, 0, 0, 0, 0, 0)
    header = struct.pack("=IHHII", 16 + len(payload), AUDIT_SET, NLM_F_REQUEST | NLM_F_ACK, 1, 0)
    return header + payload


def main() -> int:
    out = os.fdopen(int(sys.argv[1]), "wb", buffering=1 << 20)
    sock = socket.socket(socket.AF_NETLINK, socket.SOCK_RAW, NETLINK_AUDIT)
    sock.bind((0, 0))
    # SO_RCVBUF is capped by net.core.rmem_max; the forced variant (root) is not.
    sock.setsockopt(socket.SOL_SOCKET, SO_RCVBUFFORCE, 256 << 20)
    sock.send(status_message(os.getpid()))
    signal.signal(signal.SIGTERM, on_term)
    sock.settimeout(0.5)
    overflows = 0
    while True:
        try:
            data = sock.recv(1 << 16)
        except socket.timeout:
            if stopping:
                break
            continue
        except InterruptedError:
            continue
        except OSError as error:
            if error.errno != errno.ENOBUFS:
                raise
            overflows += 1
            continue
        # Each datagram carries one message. Records sent to the audit daemon
        # have nlmsg_len set to the payload length without the header (a
        # kernel quirk kept for compatibility), so it cannot be used to walk
        # the datagram.
        if len(data) < 16:
            continue
        kind = struct.unpack_from("=H", data, 4)[0]
        payload = data[16:]
        if kind == NLMSG_ERROR:
            error = struct.unpack_from("=i", payload)[0]
            if error:
                print(f"audit-reader: kernel rejected a request: errno {-error}", file=sys.stderr)
                return 1
            continue
        if kind == AUDIT_EOE:
            continue
        name = NAMES.get(kind, f"UNKNOWN[{kind}]")
        out.write(b"type=" + name.encode() + b" msg=" + payload.rstrip(b"\0\n") + b"\n")
    out.flush()
    if overflows:
        print(f"audit-reader: the socket overflowed {overflows} times", file=sys.stderr)
        return 2
    return 0


if __name__ == "__main__":
    sys.exit(main())
